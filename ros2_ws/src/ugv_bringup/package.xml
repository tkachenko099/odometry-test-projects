<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>ugv_bringup</name>
  <version>0.1.0</version>
  <description>Top-level orchestration: route commander, baseline and system launch.</description>
  <maintainer email="dev@example.com">UGV Nav Stand</maintainer>
  <license>GPL-3.0-only</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>ugv_gazebo</exec_depend>
  <exec_depend>ugv_description</exec_depend>
  <exec_depend>ugv_localization</exec_depend>
  <exec_depend>ugv_fault_injector</exec_depend>
  <exec_depend>ugv_metrics</exec_depend>
  <exec_depend>robot_localization</exec_depend>
  <exec_depend>rviz2</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>

<?xml version="1.0"?>
<!-- Differential-drive UGV: base_link + two driven wheels + passive caster,
     carrying an IMU and a GNSS receiver. Kept intentionally simple so the
     dynamics and sensor generation dominate (Section 5 of the plan). -->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="ugv">

  <!-- ================= Parameters ================= -->
  <xacro:property name="base_x" value="0.40"/>
  <xacro:property name="base_y" value="0.30"/>
  <xacro:property name="base_z" value="0.12"/>
  <xacro:property name="base_mass" value="8.0"/>

  <xacro:property name="wheel_radius" value="0.10"/>
  <xacro:property name="wheel_width" value="0.05"/>
  <xacro:property name="wheel_mass" value="0.6"/>
  <xacro:property name="wheel_track" value="0.36"/>   <!-- L: distance between wheels -->

  <xacro:property name="caster_radius" value="0.045"/>
  <xacro:property name="update_rate" value="100"/>

  <!-- ================= Macros ================= -->
  <xacro:macro name="box_inertia" params="m x y z">
    <inertial>
      <mass value="${m}"/>
      <inertia ixx="${m*(y*y+z*z)/12.0}" ixy="0" ixz="0"
               iyy="${m*(x*x+z*z)/12.0}" iyz="0"
               izz="${m*(x*x+y*y)/12.0}"/>
    </inertial>
  </xacro:macro>

  <xacro:macro name="cyl_inertia" params="m r l">
    <inertial>
      <mass value="${m}"/>
      <inertia ixx="${m*(3*r*r+l*l)/12.0}" ixy="0" ixz="0"
               iyy="${m*(3*r*r+l*l)/12.0}" iyz="0"
               izz="${m*r*r/2.0}"/>
    </inertial>
  </xacro:macro>

  <xacro:macro name="wheel" params="prefix reflect">
    <link name="${prefix}_wheel">
      <visual>
        <origin xyz="0 0 0" rpy="1.5708 0 0"/>
        <geometry><cylinder radius="${wheel_radius}" length="${wheel_width}"/></geometry>
        <material name="wheel_mat"><color rgba="0.1 0.1 0.1 1"/></material>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="1.5708 0 0"/>
        <geometry><cylinder radius="${wheel_radius}" length="${wheel_width}"/></geometry>
      </collision>
      <xacro:cyl_inertia m="${wheel_mass}" r="${wheel_radius}" l="${wheel_width}"/>
    </link>

    <joint name="${prefix}_wheel_joint" type="continuous">
      <parent link="base_link"/>
      <child link="${prefix}_wheel"/>
      <origin xyz="0 ${reflect*wheel_track/2.0} 0" rpy="0 0 0"/>
      <axis xyz="0 1 0"/>
      <dynamics damping="0.01" friction="0.01"/>
    </joint>
  </xacro:macro>

  <!-- ================= Base ================= -->
  <link name="base_footprint"/>
  <joint name="base_footprint_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <origin xyz="0 0 ${wheel_radius}" rpy="0 0 0"/>
  </joint>

  <link name="base_link">
    <visual>
      <geometry><box size="${base_x} ${base_y} ${base_z}"/></geometry>
      <material name="base_mat"><color rgba="0.2 0.4 0.8 1"/></material>
    </visual>
    <collision>
      <geometry><box size="${base_x} ${base_y} ${base_z}"/></geometry>
    </collision>
    <xacro:box_inertia m="${base_mass}" x="${base_x}" y="${base_y}" z="${base_z}"/>
  </link>

  <!-- ================= Wheels ================= -->
  <xacro:wheel prefix="left"  reflect="1"/>
  <xacro:wheel prefix="right" reflect="-1"/>

  <!-- ================= Passive caster ================= -->
  <link name="caster">
    <visual><geometry><sphere radius="${caster_radius}"/></geometry></visual>
    <collision>
      <geometry><sphere radius="${caster_radius}"/></geometry>
      <surface><friction><ode><mu>0.0</mu><mu2>0.0</mu2></ode></friction></surface>
    </collision>
    <xacro:cyl_inertia m="0.2" r="${caster_radius}" l="${caster_radius}"/>
  </link>
  <joint name="caster_joint" type="fixed">
    <parent link="base_link"/>
    <child link="caster"/>
    <origin xyz="${base_x/2.0 - caster_radius} 0 ${-(wheel_radius - caster_radius)}" rpy="0 0 0"/>
  </joint>

  <!-- ================= IMU ================= -->
  <link name="imu_link">
    <xacro:box_inertia m="0.05" x="0.03" y="0.03" z="0.02"/>
  </link>
  <joint name="imu_joint" type="fixed">
    <parent link="base_link"/>
    <child link="imu_link"/>
    <origin xyz="0 0 ${base_z/2.0}" rpy="0 0 0"/>
  </joint>

  <!-- ================= GNSS ================= -->
  <link name="gps_link">
    <xacro:box_inertia m="0.05" x="0.03" y="0.03" z="0.02"/>
  </link>
  <joint name="gps_joint" type="fixed">
    <parent link="base_link"/>
    <child link="gps_link"/>
    <origin xyz="${-base_x/4.0} 0 ${base_z/2.0 + 0.05}" rpy="0 0 0"/>
  </joint>

  <!-- ================= Gazebo (Harmonic) plugins & sensors ================= -->
  <xacro:include filename="$(find ugv_description)/urdf/ugv.gazebo.xacro"/>
  <xacro:ugv_gazebo update_rate="${update_rate}"
                    wheel_track="${wheel_track}"
                    wheel_radius="${wheel_radius}"/>

</robot>

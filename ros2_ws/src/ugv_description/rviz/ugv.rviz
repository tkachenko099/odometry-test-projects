Panels:
  - Class: rviz_common/Displays
    Name: Displays
Visualization Manager:
  Global Options:
    Fixed Frame: map
    Frame Rate: 30
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Enabled: true
    - Class: rviz_default_plugins/RobotModel
      Name: RobotModel
      Enabled: true
      Description Topic:
        Value: /robot_description
    - Class: rviz_default_plugins/TF
      Name: TF
      Enabled: true
    - Class: rviz_default_plugins/Odometry
      Name: GroundTruth
      Enabled: true
      Topic:
        Value: /ground_truth/odom
    - Class: rviz_default_plugins/Odometry
      Name: Localization
      Enabled: true
      Topic:
        Value: /localization/odom
    - Class: rviz_default_plugins/Path
      Name: EstimatedPath
      Enabled: true
      Topic:
        Value: /localization/path
    - Class: rviz_default_plugins/Path
      Name: RecordedTrail
      Enabled: true
      Color: 0; 200; 0
      Line Style: Lines
      Topic:
        Value: /rth/recorded_path
    - Class: rviz_default_plugins/Path
      Name: ReturnPath
      Enabled: true
      Color: 0; 120; 255
      Line Style: Billboards
      Line Width: 0.1
      Topic:
        Value: /rth/return_path
  Tools:
    - Class: rviz_default_plugins/MoveCamera
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 15
